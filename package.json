{
  "name": "celebration-church-stats",
  "version": "1.0.0",
  "description": "Celebration Church Statistics Portal",
  "author": "Celebration Church <admin@celebrate.org>",
  "homepage": "./",
  "private": true,
  "main": "public/electron.js",
  "scripts": {
    "start": "react-scripts start",
    "build": "react-scripts build",
    "build:win": "react-scripts build && electron-builder --win --x64",
    "build:mac": "react-scripts build && electron-builder --mac --x64"
  },
  "dependencies": {
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-scripts": "5.0.1",
    "recharts": "^2.8.0"
  },
  "devDependencies": {
    "electron": "^27.0.0",
    "electron-builder": "^24.6.4"
  },
  "build": {
    "appId": "org.celebrate.stats",
    "productName": "Celebration Church Stats",
    "directories": {
      "output": "dist"
    },
    "files": [
      "build/**/*",
      "public/electron.js",
      "node_modules/**/*",
      "package.json"
    ],
    "win": {
      "target": "portable"
    },
    "mac": {
      "target": "dmg"
    }
  },
  "browserslist": {
    "production": [">0.2%", "not dead", "not op_mini all"],
    "development": ["last 1 chrome version"]
  }
}
